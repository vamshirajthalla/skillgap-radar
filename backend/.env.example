# --- Database ---
# Leave unset to use a local SQLite file (skillgap.db) for a zero-setup start.
# For real PostgreSQL (matches the intended stack), uncomment and edit:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/skillgap

# --- LLM / NLP API (Sprint 4 recommendations) ---
# If left blank, the app falls back to built-in templated recommendations
# so the project still runs end-to-end without any API key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Jobs / Internships API (Sprint 5 opportunities) ---
# Optional. With credentials, the Internships & Jobs tab shows real individual
# postings, each linking straight to the employer's application page.
# Without them, it shows real pre-filtered searches on Internshala, LinkedIn,
# Naukri, Unstop and Indeed instead - which never go stale.
# Free credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOB_LOCATION=India
